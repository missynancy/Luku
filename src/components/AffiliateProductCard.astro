---
const { product } = Astro.props;
---
<aside class="monet-card" aria-label="Affiliate product recommendation">
  <h3>{product.title}</h3>
  <p>{product.description}</p>
  <p><strong>{product.price}</strong></p>
  <img class="affiliate-image" src={`${import.meta.env.BASE_URL}/images/${product.image}`} alt={product.title} loading="lazy" />
  <a class="btn btn-primary" href={product.link} target="_blank" rel="noopener sponsored">Check price</a>
</aside>
