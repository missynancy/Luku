---
const { product } = Astro.props;
---
<aside class="monet-card" aria-label="Affiliate product recommendation">
  <h3>{product.title}</h3>
  <p>{product.description}</p>
  <p><strong>{product.price}</strong></p>

  <div class="affiliate-carousel" data-carousel>
    <div class="slides">
      <img src="/images/yoga%201.jpg" alt="Yoga 1" />
      <img src="/images/yoga2.jpg" alt="Yoga 2" />
      <img src="/images/yoga%20mat1.jpg" alt="Yoga mat 1" />
      <img src="/images/yoga%20ma%202.jpg" alt="Yoga mat 2" />
    </div>
    <div class="controls">
      <button type="button" class="prev" aria-label="Previous">‹</button>
      <button type="button" class="next" aria-label="Next">›</button>
    </div>
    <div class="dots" aria-hidden="false">
      <button data-dot></button>
      <button data-dot></button>
      <button data-dot></button>
      <button data-dot></button>
    </div>
  </div>

  <a class="btn btn-primary" href={product.link} target="_blank" rel="noreferrer">Check Price</a>

  <script>
    (function(){
      const root = document.currentScript?.parentElement;
      if (!root) return;
      const carousel = root.querySelector('[data-carousel]');
      if (!carousel) return;
      const slides = carousel.querySelector('.slides');
      const imgs = slides.querySelectorAll('img');
      const prev = carousel.querySelector('.prev');
      const next = carousel.querySelector('.next');
      const dots = Array.from(carousel.querySelectorAll('[data-dot]'));
      let index = 0;
      function show(i){
        index = (i + imgs.length) % imgs.length;
        slides.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((d, idx) => d.classList.toggle('active', idx === index));
      }
      prev.addEventListener('click', () => show(index - 1));
      next.addEventListener('click', () => show(index + 1));
      dots.forEach((d, idx) => d.addEventListener('click', () => show(idx)));
      // autoplay
      let t = setInterval(() => show(index + 1), 4000);
      carousel.addEventListener('mouseenter', () => clearInterval(t));
      carousel.addEventListener('mouseleave', () => t = setInterval(() => show(index + 1), 4000));
      show(0);
    })();
  </script>
</aside>
