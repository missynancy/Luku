---
import '../styles/global.css';
const { title, description, image } = Astro.props;
const siteTitle = 'SmartLukuFitness';
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const siteURL = Astro.site || 'https://missynancy.github.io';
const canonicalPath = Astro.url.pathname === import.meta.env.BASE_URL ? `${Astro.url.pathname}/` : Astro.url.pathname;
const canonicalURL = new URL(canonicalPath, siteURL);
const ogImage = image ? new URL(image, siteURL) : new URL(`${import.meta.env.BASE_URL}/images/hero-image.svg`, siteURL);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="VB3GHRKS-P2Am0dNywada7okOEXF9R82V19d1qgJIz8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || 'Fitness and nutrition tips for busy people, budget-friendly Kenyan meals, and simple home workouts.'} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/images/icon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}/images/icon.png`} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || 'Fitness and nutrition tips for busy people, budget-friendly Kenyan meals, and simple home workouts.'} />
    <meta property="og:image" content={ogImage} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description || 'Fitness and nutrition tips for busy people, budget-friendly Kenyan meals, and simple home workouts.'} />
    <meta property="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href={import.meta.env.BASE_URL} aria-label="SmartLukuFitness home">
          <img src={`${import.meta.env.BASE_URL}/images/logo.png`} alt="SmartLukuFitness" />
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={import.meta.env.BASE_URL}>Home</a>
          <a href={`${import.meta.env.BASE_URL}/nutrition`}>Nutrition</a>
          <a href={`${import.meta.env.BASE_URL}/fitness`}>Fitness</a>
          <a href={`${import.meta.env.BASE_URL}/about`}>About</a>
          <a href={`${import.meta.env.BASE_URL}/contact`}>Contact</a>
          <a href={`${import.meta.env.BASE_URL}/guide`}>Guide</a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p>Health information is for general education and is not a substitute for professional medical advice.</p>
        <p>© 2026 SmartLukuFitness. Practical fitness and nutrition for real life.</p>
      </div>
    </footer>
  </body>
</html>
