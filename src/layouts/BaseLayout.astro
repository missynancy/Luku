---
import '../styles/global.css';
const { title, description, image } = Astro.props;
const siteTitle = 'SmartLukuFitness';
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const siteURL = Astro.site || 'https://missynancy.github.io';
const canonicalPath = Astro.url.pathname === import.meta.env.BASE_URL ? `${Astro.url.pathname}/` : Astro.url.pathname;
const canonicalURL = new URL(canonicalPath, siteURL);
const defaultSocialImage = Astro.url.pathname === import.meta.env.BASE_URL
  ? `${import.meta.env.BASE_URL}/images/homepage.png`
  : `${import.meta.env.BASE_URL}/images/hero-image.png`;
const ogImage = image ? new URL(image, siteURL) : new URL(defaultSocialImage, siteURL);
const siteHomeURL = new URL(import.meta.env.BASE_URL, siteURL).href;
const organizationID = `${siteHomeURL}#organization`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="VB3GHRKS-P2Am0dNywada7okOEXF9R82V19d1qgJIz8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || 'Fitness and nutrition tips for busy people, budget-friendly Kenyan meals, and simple home workouts.'} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/images/icon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}/images/icon.png`} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || 'Fitness and nutrition tips for busy people, budget-friendly Kenyan meals, and simple home workouts.'} />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}/images/logo.png`, Astro.site).href} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description || 'Fitness and nutrition tips for busy people, budget-friendly Kenyan meals, and simple home workouts.'} />
    <meta property="twitter:image" content={new URL(`${import.meta.env.BASE_URL}/images/logo.png`, Astro.site).href} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': organizationID,
          name: siteTitle,
          url: siteHomeURL,
          description: 'Practical fitness and nutrition education focused on budget-friendly Kenyan meals and home workouts.',
          address: { '@type': 'PostalAddress', addressLocality: 'Nairobi', addressCountry: 'KE' }
        },
        {
          '@type': 'WebSite',
          '@id': `${siteHomeURL}#website`,
          name: siteTitle,
          url: siteHomeURL,
          publisher: { '@id': organizationID }
        }
      ]
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href={import.meta.env.BASE_URL}>SmartLukuFitness</a>
    <img class="site-logo" src={`${import.meta.env.BASE_URL}/images/logo.png`} alt="SmartLukuFitness" />

    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="primary-nav">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <nav class="nav-links" id="primary-nav" aria-label="Primary">
      <a href={import.meta.env.BASE_URL}>Home</a>
      <a href={`${import.meta.env.BASE_URL}/nutrition`}>Nutrition</a>
      <a href={`${import.meta.env.BASE_URL}/fitness`}>Fitness</a>
      <a href={`${import.meta.env.BASE_URL}/about`}>About</a>
      <a href={`${import.meta.env.BASE_URL}/contact`}>Contact</a>
      <a href={`${import.meta.env.BASE_URL}/guide`}>Guide</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const menu = document.getElementById('primary-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <aside class="medical-disclaimer" role="note" aria-label="Medical disclaimer">
          <strong>Health disclaimer:</strong> This site provides general education only and is not a substitute for advice, diagnosis, or treatment from a qualified healthcare professional.
        </aside>
        <p class="founder-bio">Curated by <a href="https://missynancy.github.io/Portfolio/" class="author-link">Nancy Wambui</a>, a Tech-Savvy Virtual Assistant and Frontend Developer building digital operation assets in public.</p>
        <p class="footer-copyright">© 2026 SmartLukuFitness. Practical fitness and nutrition for real life.</p>
      </div>
    </footer>
  </body>
</html>
