---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="The requested page could not be found on SmartLukuFitness." noindex={true}>
  <section class="section">
    <div class="container page-intro">
      <p class="eyebrow">404 ERROR</p>
      <h1>Page Not Found</h1>
      <p>Sorry, the page you are looking for could not be found or may have moved.</p>
      <div class="hero-actions" style="margin-top: 1.5rem;">
        <a class="btn btn-primary" href={`${import.meta.env.BASE_URL}/`}>Back to Home</a>
        <a class="btn btn-secondary" href={`${import.meta.env.BASE_URL}/fitness/`}>Fitness Guides</a>
        <a class="btn btn-ghost" href={`${import.meta.env.BASE_URL}/nutrition/`}>Nutrition Guides</a>
      </div>
    </div>
  </section>
</BaseLayout>
