---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Contact SmartLukuFitness for questions, collaborations, or media inquiries.">
  <section class="section">
    <div class="container">
      <h1>Contact</h1>
      <p>Questions, partnerships, or guest-post ideas are welcome. A contact form will be added when a message-handling service is connected.</p>
      <div class="card">
        <h2>Contact details coming soon</h2>
        <p>Please check back soon for a working contact method.</p>
      </div>
    </div>
  </section>
</BaseLayout>
