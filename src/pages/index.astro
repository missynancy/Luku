---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).filter((post) => !post.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.filter((post) => post.data.featured).slice(0, 2);
const recent = posts.slice(0, 4);
---
<BaseLayout title="Home" description="SmartLukuFitness shares simple fitness and budget-friendly nutrition advice for Kenya and beyond.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="tag">Fitness • Nutrition • Simple habits</p>
        <h1>Build a stronger body with budget-friendly food and home workouts.</h1>
        <p>SmartLukuFitness helps busy people and remote workers stay healthy with practical meal ideas, easy exercises, and routines that fit real life.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={`${import.meta.env.BASE_URL}/nutrition`}>Explore Nutrition</a>
          <a class="btn btn-secondary" href={`${import.meta.env.BASE_URL}/fitness`}>Explore Fitness</a>
        </div>
      </div>

      <div class="hero-media">
        <!-- Unified container for the split image look -->
        <div class="split-banner">
          <div class="banner-left">
            <img src={`${import.meta.env.BASE_URL}/images/meal1.jpg`} alt="Kenyan meal plate featuring white corn ugali, sukuma wiki greens, and beef stew" />
          </div>
          <div class="banner-right">
            <img src={`${import.meta.env.BASE_URL}/images/image4.jpg`} alt="Home fitness workspace" />
          </div>
        </div>

        <!-- Floating card styled to match the overlay -->
        <div class="hero-side-card">
          <div class="hero-card-copy">
            <h2>Why readers love this blog</h2>
            <p>Kenyan-friendly meals using affordable staples</p>
            <p>Desk-friendly movement ideas for busy professionals</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Featured posts</h2>
      <div class="grid">
        {featured.map((post) => (
          <article class="card">
            <p class="post-meta">{post.data.category} • {post.data.readTime}</p>
            <h3><a href={`${import.meta.env.BASE_URL}/posts/${post.slug}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <div class="post-tags">
              {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
      <div class="checklist-cta">
        <h3>Plan your next healthy shop</h3>
        <p>Use a practical one-page list of affordable staples for your next Naivas or Carrefour visit.</p>
        <a class="btn btn-primary" href={`${import.meta.env.BASE_URL}/shopping-checklist`}>Download Free 1-Page Naivas/Carrefour Grocery Checklist PDF</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Recent posts</h2>
      <div class="grid">
        {recent.map((post) => (
          <article class="card">
            <p class="post-meta">{post.data.category} • {post.data.readTime}</p>
            <h3><a href={`${import.meta.env.BASE_URL}/posts/${post.slug}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
