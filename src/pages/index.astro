---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).filter((post) => !post.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredStyle = posts.filter((post) => post.data.category === 'Style').slice(0, 2);
const featuredFitness = posts.filter((post) => post.data.category === 'Fitness').slice(0, 2);
const featuredLifestyle = posts.filter((post) => post.data.category === 'Lifestyle').slice(0, 2);
const recent = posts.slice(0, 6);
---
<BaseLayout title="STYLE • FITNESS • LIFESTYLE" description="Practical style, 30-minute fitness routines, and everyday lifestyle guidance for busy working professionals in Kenya.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">SMARTLUKUFITNESS</p>
        <h1>Be Smart. Look Smart. Feel Strong.</h1>
        <p class="hero-subtitle">Practical style, fitness and lifestyle ideas for busy professionals.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={`${import.meta.env.BASE_URL}/style/`}>Explore Style</a>
          <a class="btn btn-secondary" href={`${import.meta.env.BASE_URL}/fitness/`}>Explore Fitness</a>
          <a class="btn btn-ghost" href={`${import.meta.env.BASE_URL}/lifestyle/`}>Explore Lifestyle</a>
        </div>
        <ul class="hero-points" aria-label="Brand pillars">
          <li>Dress with intention</li>
          <li>Move consistently</li>
          <li>Build practical routines</li>
        </ul>
      </div>

      <div class="hero-media">
        <div class="split-banner">
          <div class="banner-left">
            <img src={`${import.meta.env.BASE_URL}/images/office-capsule-hero-camel.jpg`} alt="Professional camel blazer office outfit" />
          </div>
          <div class="banner-right">
            <img src={`${import.meta.env.BASE_URL}/images/nancy-smart-luku.webp`} alt="Nancy Wambui styling a smart casual office outfit" />
          </div>
        </div>

        <div class="hero-side-card">
          <div class="hero-card-copy">
            <h2>STYLE • FITNESS • LIFESTYLE</h2>
            <p>Dress smart, move consistently, and build practical routines that fit your working life.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">The three pillars</p>
        <h2>Built for busy working professionals</h2>
      </div>
      <div class="pillar-grid">
        <article class="pillar-card">
          <span class="card-kicker">Style</span>
          <h3>Dress smart. Build a wardrobe that works for your real life.</h3>
          <p>Corporate wear, modest dressing, smart casual combinations, and a transparent journey into learning fashion design.</p>
          <a href={`${import.meta.env.BASE_URL}/style/`}>Explore style guides →</a>
        </article>

        <article class="pillar-card">
          <span class="card-kicker">Fitness</span>
          <h3>Make movement fit your schedule — especially when you only have 30 minutes.</h3>
          <p>30-minute full-body routines, no-equipment home workouts, and workday mobility to keep you active without gym hassle.</p>
          <a href={`${import.meta.env.BASE_URL}/fitness/`}>Explore fitness routines →</a>
        </article>

        <article class="pillar-card">
          <span class="card-kicker">Lifestyle</span>
          <h3>Build practical routines that make working life easier.</h3>
          <p>Personal organization, time management systems, weekly preparation, and habits that boost everyday confidence.</p>
          <a href={`${import.meta.env.BASE_URL}/lifestyle/`}>Explore lifestyle systems →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Featured reads</p>
        <h2>What professionals are reading right now</h2>
      </div>

      <div class="feature-grid">
        <div class="feature-column">
          <h3>Style</h3>
          {featuredStyle.map((post) => (
            <article class="mini-card">
              <p class="post-meta">{post.data.category} • {post.data.readTime}</p>
              <h4><a href={`${import.meta.env.BASE_URL}/posts/${post.slug}/`}>{post.data.title}</a></h4>
              <p>{post.data.description}</p>
            </article>
          ))}
        </div>

        <div class="feature-column">
          <h3>Fitness</h3>
          {featuredFitness.map((post) => (
            <article class="mini-card">
              <p class="post-meta">{post.data.category} • {post.data.readTime}</p>
              <h4><a href={`${import.meta.env.BASE_URL}/posts/${post.slug}/`}>{post.data.title}</a></h4>
              <p>{post.data.description}</p>
            </article>
          ))}
        </div>

        <div class="feature-column">
          <h3>Lifestyle</h3>
          {featuredLifestyle.map((post) => (
            <article class="mini-card">
              <p class="post-meta">{post.data.category} • {post.data.readTime}</p>
              <h4><a href={`${import.meta.env.BASE_URL}/posts/${post.slug}/`}>{post.data.title}</a></h4>
              <p>{post.data.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Latest articles</p>
        <h2>Practical ideas for everyday working life</h2>
      </div>
      <div class="grid">
        {recent.map((post) => (
          <article class="card">
            <p class="post-meta">{post.data.category} • {post.data.readTime}</p>
            <h3><a href={`${import.meta.env.BASE_URL}/posts/${post.slug}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <div class="post-tags">
              {post.data.tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container luku-story">
      <div>
        <p class="eyebrow">What is Luku?</p>
        <h2>It means looking smart, dressing well, and carrying yourself with confidence.</h2>
      </div>
      <p>
        In Nairobi Sheng, <strong>Luku</strong> means looking smart, dressing well, or throwing a good outfit. At SmartLukuFitness, style is central to personal presentation. Being Smart Luku is about dressing with intention, staying consistent with movement, and building habits that give you genuine confidence every day.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="checklist-cta">
        <h3>Start with Style</h3>
        <p>Explore practical corporate, modest, and smart casual outfit guides built for real working days in Kenya.</p>
        <a class="btn btn-primary" href={`${import.meta.env.BASE_URL}/style/`}>Explore style guides</a>
      </div>
    </div>
  </section>
</BaseLayout>
