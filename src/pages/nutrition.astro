---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).filter((post) => !post.data.draft && post.data.category === 'Nutrition').sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Nutrition" description="Budget-friendly nutrition tips, Kenyan meal ideas, and healthy eating advice for everyday life.">
  <section class="section">
    <div class="container">
      <h1>Nutrition</h1>
      <p>Simple nutrition ideas built around affordable, practical foods that work for Kenyan households and busy professionals.</p>
      <div class="grid">
        {posts.map((post) => (
          <article class="card">
            <h2><a href={`${import.meta.env.BASE_URL}/posts/${post.slug}`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
