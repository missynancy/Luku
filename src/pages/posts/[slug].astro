---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateProductCard from '../../components/AffiliateProductCard.astro';
import EmailSignup from '../../components/EmailSignup.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sameCategoryPosts = allPosts
  .filter((entry) => entry.slug !== post.slug && entry.data.category === post.data.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
const crossPillarPosts = allPosts
  .filter((entry) => entry.slug !== post.slug && entry.data.category !== post.data.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
const relatedPosts = [...sameCategoryPosts, ...crossPillarPosts].slice(0, 4);
const articleImage = post.data.image ? `${import.meta.env.BASE_URL}/images/${post.data.image}` : `${import.meta.env.BASE_URL}/images/hero-image.svg`;
const socialImage = post.data.image ? `/images/${post.data.image}` : `/images/hero-image.svg`;
const siteURL = Astro.site || 'https://missynancy.github.io';
const articleURL = new URL(`${import.meta.env.BASE_URL}/posts/${post.slug}/`, siteURL);
const articleImageURL = new URL(articleImage, siteURL);
---
<BaseLayout title={post.data.title} description={post.data.description} image={socialImage}>
  <article class="article">
    <header class="article-header">
      <p class="post-meta">{post.data.category} • {post.data.readTime}</p>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      {post.data.image && (
        <div class="article-image" style="max-height: 600px; text-align: center; border-radius: 18px; margin-bottom: 1.5rem; background: var(--color-secondary-soft, #f8f9fa); padding: 1rem; overflow: hidden;">
          <img src={articleImage} alt={post.data.imageAlt || post.data.title} style="max-height: 560px; width: auto; max-width: 100%; object-fit: contain; border-radius: 12px; display: inline-block;" />
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    {post.data.affiliateProduct && <AffiliateProductCard product={post.data.affiliateProduct} />}
    <EmailSignup />

    <section class="related-posts" aria-labelledby="related-posts-heading">
      <h2 id="related-posts-heading">Keep reading</h2>
      <div class="related-grid">
        {relatedPosts.map((entry) => (
          <article class="related-card">
            <p class="post-meta">{entry.data.category} • {entry.data.readTime}</p>
            <h3><a href={`${import.meta.env.BASE_URL}/posts/${entry.slug}`}>{entry.data.title}</a></h3>
            <p>{entry.data.description}</p>
          </article>
        ))}
      </div>
      <div class="read-next-links">
        <a href={`${import.meta.env.BASE_URL}/nutrition`}>More nutrition guides →</a>
        <a href={`${import.meta.env.BASE_URL}/fitness`}>More fitness guides →</a>
        <a href={`${import.meta.env.BASE_URL}/style`}>Style & Luku inspiration →</a>
      </div>
    </section>
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Article',
        headline: post.data.title,
        description: post.data.description,
        image: [articleImageURL.href],
        author: { '@type': 'Person', name: 'Nancy Wambui', url: 'https://missynancy.github.io/Portfolio/' },
        publisher: { '@type': 'Organization', name: 'SmartLukuFitness', url: siteURL },
        datePublished: post.data.pubDate.toISOString(),
        mainEntityOfPage: articleURL.href
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: siteURL },
          { '@type': 'ListItem', position: 2, name: post.data.category || 'Posts', item: `${siteURL}/#posts` },
          { '@type': 'ListItem', position: 3, name: post.data.title, item: articleURL.href }
        ]
      }
    ]
  })} />
</BaseLayout>
