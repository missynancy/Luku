---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Free Grocery Checklist" description="A practical one-page Kenyan grocery checklist for affordable, balanced meals.">
  <section class="section checklist-page">
    <div class="container checklist-card">
      <p class="tag">Free printable</p>
      <h1>Naivas/Carrefour Grocery Checklist</h1>
      <p>Use this one-page checklist to build simple, balanced meals with affordable Kenyan staples.</p>
      
      <!-- Grid updated to 4 columns implicitly via content layout -->
      <div class="checklist-grid">
        <section>
          <h2>Protein</h2>
          <ul>
            <li><label class="checklist-item"><input type="checkbox" id="eggs" /><span>Eggs <span class="item-quantity">(1 tray)</span></span></label></li>
            <li><label class="checklist-item"><input type="checkbox" id="ndengu" /><span>Beans or ndengu <span class="item-quantity">(1 kg)</span></span></label></li>
            <li><label class="checklist-item"><input type="checkbox" id="omena" /><span>Omena <span class="item-quantity">(500g)</span></span></label></li>
            <li><label class="checklist-item"><input type="checkbox" id="yoghurt" /><span>Plain yoghurt <span class="item-quantity">(500ml)</span></span></label></li>
          </ul>
        </section>
        
        <section>
          <h2>Greens & fruit</h2>
          <ul>
            <li><label class="checklist-item"><input type="checkbox" id="sukuma" /><span>Sukuma wiki <span class="item-quantity">(2 bunches)</span></span></label></li>
            <li><label class="checklist-item"><input type="checkbox" id="spinach" /><span>Spinach <span class="item-quantity">(1 bunch)</span></span></label></li>
            <li><label class="checklist-item"><input type="checkbox" id="tomatoes" /><span>Tomatoes and onions <span class="item-quantity">(4-5 each)</span></span></label></li>
            <li><label class="checklist-item"><input type="checkbox" id="fruit" /><span>Seasonal fruit <span class="item-quantity">(based on season)</span></span></label></li>
          </ul>
        </section>
        
        <section>
          <h2>Filling staples</h2>
          <ul>
            <li><label class="checklist-item"><input type="checkbox" id="ugali" /><span>Unga ya ugali <span class="item-quantity">(2 kg)</span></span></label></li>
            <li><label class="checklist-item"><input type="checkbox" id="rice" /><span>Rice <span class="item-quantity">(1 kg)</span></span></label></li>
            <li><label class="checklist-item"><input type="checkbox" id="oats" /><span>Oats <span class="item-quantity">(500g)</span></span></label></li>
            <li><label class="checklist-item"><input type="checkbox" id="potatoes" /><span>Sweet potatoes <span class="item-quantity">(1 kg)</span></span></label></li>
          </ul>
        </section>

        <section>
          <h2>Healthy snacks</h2>
          <ul>
            <li><label class="checklist-item"><input type="checkbox" id="groundnuts" /><span>Groundnuts <span class="item-quantity">(250g)</span></span></label></li>
            <li><label class="checklist-item"><input type="checkbox" id="popcorn" /><span>Popcorn (Mahindi) <span class="item-quantity">(500g)</span></span></label></li>
            <li><label class="checklist-item"><input type="checkbox" id="avocado" /><span>Avocado <span class="item-quantity">(2-3)</span></span></label></li>
          </ul>
        </section>
      </div>

      <div class="checklist-footer">
        <p class="tip-text">💡 <strong>Shopping Tip:</strong> Skip pre-packaged snacks. Go to the open grain dispenser section at Naivas to buy ndengu and groundnuts by weight—it's way cheaper.</p>
        <button class="btn btn-primary" type="button" onclick="window.print()">Print or Save as PDF</button>
      </div>
    </div>
  </section>
</BaseLayout>