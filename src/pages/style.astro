---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).filter(
  (post) => !post.data.draft && (post.data.category === 'Style' || post.data.category === 'Style & Luku' || post.data.tags?.includes('office wear') || post.data.tags?.includes('style'))
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Style & Luku" description="Smart office outfit guides, capsule wardrobes, and professional dress codes for busy Kenyan professionals.">
  <section class="section">
    <div class="container">
      <div class="style-hero-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; align-items: center; margin-bottom: 2.5rem; background: var(--color-secondary-soft, #f8f9fa); padding: 2rem; border-radius: 18px; border: 1px solid var(--color-border, #e9ecef);">
        <div>
          <span class="tag" style="background: var(--color-primary, #e63946); color: white; padding: 0.25rem 0.75rem; border-radius: 50px; font-size: 0.85rem; font-weight: 600;">Style & Luku Inspiration</span>
          <h1 style="margin-top: 0.75rem; font-size: 2.2rem;">Look Sharp. Feel Confident.</h1>
          <p style="font-size: 1.1rem; color: var(--color-text-muted, #495057); line-height: 1.6;">
            Being "Smart Luku" is about combining a fit, healthy body with polished, professional styling. Discover practical office outfit guides, capsule wardrobes, and budget-friendly dress codes tailored for busy professionals in Kenya.
          </p>
        </div>
        <div style="text-align: center;">
          <img src={`${import.meta.env.BASE_URL}/images/nancy-smart-luku.webp`} alt="Nancy Wambui styling a smart casual office outfit" style="width: 100%; max-width: 360px; height: auto; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); object-fit: contain; display: inline-block;" />
        </div>
      </div>

      <h2>Latest Style Guides</h2>
      <div class="grid">
        {posts.map((post) => (
          <article class="card">
            <p class="post-meta">{post.data.category} • {post.data.readTime}</p>
            <h2><a href={`${import.meta.env.BASE_URL}/posts/${post.slug}`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
