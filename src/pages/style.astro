---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).filter(
  (post) => !post.data.draft && (post.data.category === 'Style' || post.data.tags?.includes('office wear') || post.data.tags?.includes('style'))
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const focusAreas = ['Office Style', 'Smart Casual', 'Budget Dressing', 'Kenyan Workwear', 'Capsule Wardrobes', 'Thrift & Mtumba Style', 'Grooming', 'Personal Presentation'];
---
<BaseLayout title="Style & Luku" description="Discover practical office style, smart casual dressing, and budget-friendly Luku-inspired fashion for everyday confidence in Kenya.">
  <section class="section">
    <div class="container">
      <div class="style-hero-grid">
        <div>
          <p class="eyebrow">STYLE &amp; LUKU</p>
          <h1>Look sharp. Feel confident. Dress with intention.</h1>
          <p>
            In Nairobi Sheng, <strong>Luku</strong> means looking smart, dressing well, or throwing a good outfit. At SmartLukuFitness, style is not separate from your fitness and nutrition — it is part of how you present yourself, feel, and show up in the world.
          </p>
        </div>
        <div class="style-hero-image-wrap">
          <img src={`${import.meta.env.BASE_URL}/images/nancy-smart-luku.webp`} alt="Nancy Wambui styling a smart casual office outfit" class="style-hero-image" />
        </div>
      </div>

      <div class="category-cloud" aria-label="Style categories">
        {focusAreas.map((item) => <span class="tag">{item}</span>)}
      </div>

      <div class="feature-highlight">
        <p class="eyebrow">Anchor article</p>
        <h2>Smart Office Outfit Guide for Busy Kenyan Professionals</h2>
        <p>Start with a practical, affordable roadmap for building a polished work wardrobe without overspending.</p>
        <a class="btn btn-primary" href={`${import.meta.env.BASE_URL}/posts/smart-office-outfit-guide-kenyan-professionals`}>Read the office style guide</a>
      </div>

      <div class="grid">
        {posts.map((post) => (
          <article class="card">
            <p class="post-meta">{post.data.category} • {post.data.readTime}</p>
            <h2><a href={`${import.meta.env.BASE_URL}/posts/${post.slug}`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <div class="post-tags">
              {post.data.tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
