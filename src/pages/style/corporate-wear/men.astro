---
import GenderStyleLayout from '../../../components/GenderStyleLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).filter(
  (post) => !post.data.draft && post.data.category === 'Style' && post.data.tags?.some((t) => t.toLowerCase().includes('men'))
);

const topics = ['Dress Shirts', 'Tailored Trousers', 'Corporate Blazers', 'Leather Oxford & Loafer Shoes', 'Ties & Belts', 'Suit Rotation'];
---
<GenderStyleLayout
  category="Corporate Wear"
  categorySlug="corporate-wear"
  gender="Men"
  genderSlug="men"
  heroImage="office-capsule-hero-camel.jpg"
  description="Tailored corporate wear for men — building a sharp, professional office wardrobe with versatile dress shirts, trousers, blazers, and leather footwear."
  topics={topics}
  posts={posts}
/>
